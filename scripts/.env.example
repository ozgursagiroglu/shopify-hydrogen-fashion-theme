# Shopify Admin API Configuration
# Get these from your Shopify Admin: Settings > Apps > Develop apps

# Your store's myshopify.com domain (without https://)
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Admin API access token (NOT Storefront API token)
# Required scopes for full seed:
#   - read_metaobject_definitions, write_metaobject_definitions (create metaobject schemas)
#   - read_metaobjects, write_metaobjects (homepage content)
#   - read_content, write_content (blogs & articles)
#   - read_online_store_pages, write_online_store_pages (custom pages)
#   - read_legal_policies, write_legal_policies (shop policies - OPTIONAL, see note below)
#   - read_files, write_files (image uploads)
#   - read_products, write_products (demo products)
#   - read_inventory, write_inventory (stock levels)
#   - read_locations (inventory locations)
#
# ⚠️  NOTE: Demo policies are for development/preview only!
# Skip legal policy scopes if you don't want demo policies, or plan to add your own later.
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
