  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozgursagiroglu/shopify-hydrogen-fashion-theme.git"
  },
  "bugs": {
    "url": "https://github.com/ozgursagiroglu/shopify-hydrogen-fashion-theme/issues"
  },
  "keywords": [
    "shopify",
    "hydrogen",
    "shopify-hydrogen",
    "headless-commerce",
    "storefront",
    "ecommerce",
    "fashion",
    "theme",
    "starter-kit",
    "react-router",
    "tailwindcss",
    "typescript",
    "oxygen",
    "storefront-api"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "yarn --cwd hydrogen dev",
