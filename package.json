    "test": "yarn --cwd hydrogen test",
    "test:coverage": "yarn --cwd hydrogen test:coverage",
    "test:e2e": "yarn --cwd hydrogen test:e2e",
    "storybook": "yarn --cwd hydrogen storybook",
    "setup": "yarn --cwd scripts setup",
    "seed": "yarn --cwd scripts seed",
    "seed:all": "yarn --cwd scripts seed:all",
    "validate": "yarn --cwd scripts validate"
