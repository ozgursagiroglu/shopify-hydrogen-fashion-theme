# ========================================
# ada ÉLAN STARTER KIT - Environment Variables
# ========================================
# Copy this file to .env and fill in your store's values
# Get these from your Shopify admin: Settings > Apps > Develop apps

# ========================================
# REQUIRED VARIABLES
# ========================================

# Your store's Shopify domain (without https://)
# Example: my-store.myshopify.com
# Also used for same-origin link detection in CMS content
PUBLIC_STORE_DOMAIN=your-store.myshopify.com

# Your store's unique Shop ID
# Find this in Admin > Settings > General > Store details
SHOP_ID=your-shop-id

# Storefront API access token
# Create a custom app in Admin > Settings > Apps > Develop apps
# Enable Storefront API and copy the access token
PUBLIC_STOREFRONT_API_TOKEN=your-storefront-access-token

# Storefront API version (use latest stable version)
# Current stable: 2025-10
# Update this when Shopify releases new API versions
PUBLIC_STOREFRONT_API_VERSION=2025-10

# Session secret for cookie encryption
# IMPORTANT: Generate a secure random string (minimum 32 characters)
# You can use: openssl rand -base64 32
SESSION_SECRET=your-random-session-secret-minimum-32-characters

# ========================================
# CUSTOMER ACCOUNT API (Required for Login)
# ========================================
# Enable these for customer authentication features

# Customer Account API client ID
# Get from Admin > Settings > Customer accounts > Hydrogen custom storefront
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=your-client-id

# Customer Account API authorization URL
# Format: https://shopify.com/authentication/{SHOP_ID}/oauth/authorize
# Replace {SHOP_ID} with your actual Shop ID
PUBLIC_CUSTOMER_ACCOUNT_API_URL=https://shopify.com/authentication/your-shop-id/oauth/authorize

# ========================================
# ADMIN API (Required for Contact & Reviews)
# ========================================
# Required for contact form submissions and customer reviews
# These features will not work without Admin API access

# Admin API access token
# Create in Admin > Settings > Apps > Develop apps
# Enable Admin API with these scopes:
#   - write_metaobjects (for contact submissions & reviews)
#   - read_metaobjects (to display reviews)
ADMIN_API_ACCESS_TOKEN=your-admin-api-access-token

# Admin API version (should match Storefront API version)
ADMIN_API_VERSION=2025-10

# ========================================
# OPTIONAL VARIABLES
# ========================================

# Checkout domain (usually same as store domain)
# Only set if using a custom checkout domain
# PUBLIC_CHECKOUT_DOMAIN=checkout.your-store.com

# Storefront ID (for analytics and tracking)
# Get from Shopify Admin if you have analytics enabled
# PUBLIC_STOREFRONT_ID=your-storefront-id

# ========================================
# DEVELOPMENT NOTES
# ========================================
# 1. Never commit your .env file to version control
# 2. Use strong, unique SESSION_SECRET for each environment
# 3. Keep API tokens secure and rotate them regularly
# 4. Update API versions when Shopify deprecates old versions
# 5. Test all features after updating API versions

# ========================================
# QUICK SETUP COMMANDS
# ========================================
# After creating your custom app in Shopify:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your store's values in .env
# 3. Generate session secret: openssl rand -base64 32
# 4. Test locally: yarn dev
# 5. Deploy to production with environment variables set
